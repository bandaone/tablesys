"""
Notification Service

Handles creating, fetching, and managing user notifications.
Integrates with email service for optional email notifications.
"""

from sqlalchemy.orm import Session
from typing import List, Dict, Any, Optional
from datetime import datetime
from ..models import Notification, User
from .email_service import EmailService


class NotificationService:
    """Service for managing notifications"""
    
    def __init__(self, db: Session):
        self.db = db
        self.email_service = EmailService()
    
    def create_notification(
        self,
        user_id: int,
        title: str,
        message: str,
        type: str = "info",
        action_link: Optional[str] = None,
        send_email: bool = False
    ) -> Notification:
        """
        Create a new notification for a user.
        
        Args:
            user_id: ID of the user to notify
            title: Notification title
            message: Notification message
            type: Type of notification (info, success, warning, error)
            action_link: Optional link for action button
            send_email: Whether to also send email notification
            
        Returns:
            Notification: The created notification
        """
        notification = Notification(
            user_id=user_id,
            title=title,
            message=message,
            type=type,
            is_read=False,
            created_at=datetime.utcnow(),
            action_link=action_link
        )
        
        self.db.add(notification)
        self.db.commit()
        self.db.refresh(notification)
        
        # Optionally send email
        if send_email:
            user = self.db.query(User).filter(User.id == user_id).first()
            if user and user.email:
                self._send_email_notification(user, title, message, action_link)
        
        return notification
    
    def _send_email_notification(
        self,
        user: User,
        title: str,
        message: str,
        action_link: Optional[str] = None
    ):
        """Send email version of notification"""
        body_html = f"""
        <html>
        <head>
            <style>
                body {{ font-family: Arial, sans-serif; line-height: 1.6; color: #333; }}
                .container {{ max-width: 600px; margin: 0 auto; padding: 20px; }}
                .header {{ background-color: #1976d2; color: white; padding: 20px; text-align: center; }}
                .content {{ padding: 20px; background-color: #f5f5f5; }}
                .button {{ display: inline-block; padding: 12px 24px; background-color: #1976d2; 
                          color: white; text-decoration: none; border-radius: 4px; margin-top: 20px; }}
                .footer {{ text-align: center; color: #666; font-size: 12px; margin-top: 30px; }}
            </style>
        </head>
        <body>
            <div class="container">
                <div class="header">
                    <h1>{title}</h1>
                </div>
                <div class="content">
                    <p>Hello {user.full_name},</p>
                    <p>{message}</p>
                    {f'<a href="{action_link}" class="button">View Details</a>' if action_link else ''}
                </div>
                <div class="footer">
                    <p>This is an automated message from the TABLESYS Timetable Management System.</p>
                    <p>&copy; 2026 TABLESYS</p>
                </div>
            </div>
        </body>
        </html>
        """
        
        self.email_service.send_email(
            [user.email],
            title,
            body_html
        )
    
    def get_user_notifications(
        self,
        user_id: int,
        unread_only: bool = False,
        limit: int = 50
    ) -> List[Dict[str, Any]]:
        """
        Get notifications for a user.
        
        Args:
            user_id: ID of the user
            unread_only: Whether to only fetch unread notifications
            limit: Maximum number of notifications to return
            
        Returns:
            List of notification dictionaries
        """
        query = self.db.query(Notification).filter(Notification.user_id == user_id)
        
        if unread_only:
            query = query.filter(Notification.is_read == False)
        
        notifications = query.order_by(Notification.created_at.desc()).limit(limit).all()
        
        return [
            {
                "id": n.id,
                "title": n.title,
                "message": n.message,
                "type": n.type,
                "is_read": n.is_read,
                "created_at": n.created_at,
                "read_at": n.read_at,
                "action_link": n.action_link
            }
            for n in notifications
        ]
    
    def mark_as_read(self, notification_id: int, user_id: int) -> bool:
        """
        Mark a notification as read.
        
        Args:
            notification_id: ID of the notification
            user_id: ID of the user (for ownership verification)
            
        Returns:
            bool: True if marked successfully
        """
        notification = self.db.query(Notification).filter(
            Notification.id == notification_id,
            Notification.user_id == user_id
        ).first()
        
        if not notification:
            return False
        
        notification.is_read = True
        notification.read_at = datetime.utcnow()
        self.db.commit()
        return True
    
    def mark_all_as_read(self, user_id: int) -> int:
        """
        Mark all notifications as read for a user.
        
        Args:
            user_id: ID of the user
            
        Returns:
            int: Number of notifications marked as read
        """
        now = datetime.utcnow()
        count = self.db.query(Notification).filter(
            Notification.user_id == user_id,
            Notification.is_read == False
        ).update({
            "is_read": True,
            "read_at": now
        })
        
        self.db.commit()
        return count
    
    def delete_notification(self, notification_id: int, user_id: int) -> bool:
        """
        Delete a notification.
        
        Args:
            notification_id: ID of the notification
            user_id: ID of the user (for ownership verification)
            
        Returns:
            bool: True if deleted successfully
        """
        notification = self.db.query(Notification).filter(
            Notification.id == notification_id,
            Notification.user_id == user_id
        ).first()
        
        if not notification:
            return False
        
        self.db.delete(notification)
        self.db.commit()
        return True
    
    def get_unread_count(self, user_id: int) -> int:
        """
        Get count of unread notifications for a user.
        
        Args:
            user_id: ID of the user
            
        Returns:
            int: Count of unread notifications
        """
        return self.db.query(Notification).filter(
            Notification.user_id == user_id,
            Notification.is_read == False
        ).count()
    
    def notify_coordinators(
        self,
        title: str,
        message: str,
        type: str = "info",
        action_link: Optional[str] = None,
        send_email: bool = False
    ) -> int:
        """
        Send notification to all coordinators.
        
        Args:
            title: Notification title
            message: Notification message
            type: Type of notification
            action_link: Optional action link
            send_email: Whether to send email
            
        Returns:
            int: Number of coordinators notified
        """
        coordinators = self.db.query(User).filter(
            User.role == "coordinator",
            User.is_active == True
        ).all()
        
        count = 0
        for coordinator in coordinators:
            self.create_notification(
                coordinator.id,
                title,
                message,
                type,
                action_link,
                send_email
            )
            count += 1
        
        return count
    
    def notify_hods(
        self,
        title: str,
        message: str,
        type: str = "info",
        department_id: Optional[int] = None,
        action_link: Optional[str] = None,
        send_email: bool = False
    ) -> int:
        """
        Send notification to HODs (optionally filtered by department).
        
        Args:
            title: Notification title
            message: Notification message
            type: Type of notification
            department_id: Optional department filter
            action_link: Optional action link
            send_email: Whether to send email
            
        Returns:
            int: Number of HODs notified
        """
        query = self.db.query(User).filter(
            User.role == "hod",
            User.is_active == True
        )
        
        if department_id:
            query = query.filter(User.department_id == department_id)
        
        hods = query.all()
        
        count = 0
        for hod in hods:
            self.create_notification(
                hod.id,
                title,
                message,
                type,
                action_link,
                send_email
            )
            count += 1
        
        return count
