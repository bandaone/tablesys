# TABLESYS — Environment Variables
# Copy this file to .env and fill in all REQUIRED values before starting.
# Lines marked REQUIRED have no default and WILL cause startup failure if missing.
# Lines marked OPTIONAL have safe defaults shown here.

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED
POSTGRES_PASSWORD=GENERATE_A_32PLUS_CHAR_DATABASE_PASSWORD

# OPTIONAL (defaults shown)
POSTGRES_DB=tablesys_db
POSTGRES_USER=tablesys
POSTGRES_PORT=5432

# ── Application Security ─────────────────────────────────────────────────────
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERATE_A_64_CHAR_RANDOM_HEX_SECRET_KEY

# REQUIRED — used by backend/seed_users.py for initial coordinator/HOD accounts.
# Must be 16+ chars and not include weak patterns (pass, admin123, password, change-me).
TABLESYS_INITIAL_USER_PASSWORD=GENERATE_A_24PLUS_CHAR_BOOTSTRAP_USER_PASSWORD

# OPTIONAL
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=production

# ── University Identity ───────────────────────────────────────────────────────
# Set these to brand the system for your institution.
UNIVERSITY_NAME=University of Zambia
UNIVERSITY_SHORT_NAME=UNZA
UNIVERSITY_EMAIL_DOMAIN=unza.zm
APP_TITLE=TABLESYS — Timetable Management System

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# URL where your frontend is hosted (added to CORS allowed origins).
# Leave blank for localhost-only access.
FRONTEND_URL=
FRONTEND_PORT=3002
BACKEND_PORT=8000

# API URL the frontend uses to reach the backend.
VITE_API_URL=http://localhost:8000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Set EMAIL_ENABLED=true and fill credentials to enable email notifications.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
